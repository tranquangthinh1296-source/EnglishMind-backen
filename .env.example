# ─────────────────────────────────────────────────────────────
# EnglishMind backend env. Copy to .env (Railway: set as Variables).
# ─────────────────────────────────────────────────────────────

# Port (Railway injects PORT automatically; default 8080 locally)
PORT=8080

# EnglishMind Web (Next.js) — comma-separated browser origins allowed to call this API directly.
# Leave empty to block all cross-origin browser requests (Android isn't a browser, unaffected).
WEB_ALLOWED_ORIGINS=https://englishmind.app,http://localhost:3000
# Railway deploy stability (set as service Variables on Railway, not in .env locally):
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
# RAILWAY_HEALTHCHECK_TIMEOUT_SEC=60
# SHUTDOWN_GRACE_MS=25000

# Gemini API key held ONLY on the server (never ship to client).
# Use separate keys per environment: DEV (local .env), BETA (Railway beta), PROD (Play release).
GEMINI_API_KEY=your-gemini-api-key
# Primary + fallback — keep in sync with Firebase Remote Config model_name / fallback_model_name.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_DEFAULT=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
# Legacy alias (same as GEMINI_MODEL_DEFAULT):
# GEMINI_MODEL=gemini-2.5-flash-lite

# Firebase Admin credentials.
# Option A (recommended on Railway): paste the full service-account JSON
# as a single-line value of FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Option B (local): point GOOGLE_APPLICATION_CREDENTIALS to a key file
# and leave FIREBASE_SERVICE_ACCOUNT empty.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# AI-SAFE plan-based daily quota (source of truth for /api/ai/generate).
# Owner decision 2026-07-04: free = 5.
FREE_DAILY_AI_UNITS=5
PLUS_DAILY_AI_UNITS=100
PRO_DAILY_AI_UNITS=500
COACH_BETA_DAILY_AI_UNITS=250
# Required when admin custom claim is true; never leave empty in production.
ADMIN_DAILY_AI_UNITS=500
# Firestore quota reserve timeout (ms). Web anonymous cold-start can exceed 1.5s; default 5s + 1 retry.
AI_QUOTA_TIMEOUT_MS=5000
# Timezone used to compute the "server day" for quota reset.
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh

# Cost monitoring (rough, ops visibility only — see services/costEstimator.js).
# Set a USD threshold to emit a once-per-day cost_alert log when crossed; leave unset to disable.
# COST_ALERT_DAILY_USD=2.0
# Optional webhook for cost_alert, cost_cap, and quota-store unavailable alerts. Blank = off.
# ALERT_WEBHOOK_URL=
# Hard daily cost kill-switch for /api/ai and /api/stt. Firestore hiccups fail open;
# Google Cloud budget cap is still required as the final backstop.
# COST_KILL_DAILY_USD=5
# Optional per-1M-token price overrides if Gemini pricing drifts (defaults are flash-tier estimates).
# COST_FLASH_LITE_INPUT_PER_1M=0.1
# COST_FLASH_LITE_OUTPUT_PER_1M=0.4
# COST_FLASH_INPUT_PER_1M=0.3
# COST_FLASH_OUTPUT_PER_1M=2.5

# Abuse guards for /api/ai and /api/stt (5-minute windows).
RATE_AI_UID_5M=30
RATE_STT_UID_5M=10
RATE_TOWER_UID_5M=20
RATE_IP_5M=120

# Firebase App Check rollout: off (default) | log | enforce.
# Keep off/log until the client ships App Check SDK + Play Integrity is registered.
APP_CHECK_MODE=off

# Server-side systemInstruction registry. Keep false until all clients send promptParams.
REQUIRE_SERVER_SI=false

# Optional: upstream content server to proxy GET content endpoints to,
# so curricula/lessons/vocabulary/tower keep working without re-hosting data.
# Leave empty to return 501 for those endpoints.
CONTENT_UPSTREAM_URL=https://englishmind-content.up.railway.app

# Required HMAC secret for signing trial-status responses.
TRIAL_HMAC_SECRET=
# Trial length in days for new installs.
TRIAL_DAYS=7

# VOICE-STT-SERVER-1: server-side whisper.cpp STT (Dockerfile — NOT Railpack).
# Bật sau khi deploy Docker xong (build ~10–20 phút lần đầu).
SERVER_STT_ENABLED=true
STT_ENGINE=whisper
WHISPER_BIN=/app/bin/whisper-cli
WHISPER_MODEL=/app/models/ggml-base.bin
STT_TIMEOUT_MS=30000
FFMPEG_BIN=ffmpeg

# VOICE-PACK-1D: OTA voice pack (host zip on this server — no Firebase Storage / Blaze).
# After deploy, set PUBLIC URL to your Railway domain + path below.
VOICE_PACK_ENABLED=true
VOICE_PACK_PUBLIC_URL=https://englishmind-backen-production.up.railway.app/static/voice-packs/voice-pack-v1.zip
VOICE_PACK_SHA256=af2db21eaf031327e3038668ee167c0a28c1bc1f7e0666a70932eb8fe5b4ecb7
VOICE_PACK_SIZE_BYTES=230
VOICE_PACK_VERSION=v1
VOICE_PACK_ENGINE=mock
VOICE_PACK_MIN_APP_VERSION=1.0.2-beta
VOICE_PACK_PRO_ONLY=false
VOICE_PACK_SIGNING_SECRET=change-me-voice-pack-signing-secret

# VOICE-LIVE-INFRA-1: Gemini Live proxy gateway. Defaults are safe/off.
VOICE_LIVE_ENABLED=false
VOICE_LIVE_TRANSLATE_ENABLED=false
VOICE_LIVE_DAILY_SECONDS_FREE=0
VOICE_LIVE_DAILY_SECONDS_PRO=300
VOICE_LIVE_MAX_SESSION_SECONDS=180
# Server-side only; never expose model names to Android/web clients.
VOICE_LIVE_TUTOR_MODEL=gemini-3.1-flash-live-preview
VOICE_LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# Optional override for tests/dev only. Production uses the Gemini Live WSS endpoint.
# VOICE_LIVE_WS_URL=
# VOICE_LIVE_UPSTREAM_TIMEOUT_MS=10000

# PAYMENTS-SECURITY-1: Google Play subscription verification (Android Publisher API).
# Service account JSON (one line) with androidpublisher scope; linked in Play Console.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.englishmind.vxbqkt
# BILLING_MOCK=true  # dev/tests only — ignored when NODE_ENV=production; never set on prod

# B1: Beta Ops — auth key for /v1/feedback, /v1/bug-report, /v1/event, /v1/ai/*.
# Must equal the client's BETA_OPS_API_SECRET and be >= 24 chars.
BETA_OPS_KEY=change-me-to-a-long-random-string
# Railway PostgreSQL (beta_feedback, beta_bug_report, ai_usage_daily, beta_event_log).
# Leave empty -> feedback/bug/event return 503, can-use fails open.
DATABASE_URL=
# Set to "require" when DATABASE_URL is Railway's PUBLIC proxy URL (TLS, no CA verify).
# PGSSL=require

# Optional Redis hot cache for replay-heavy STT. Missing REDIS_URL keeps the existing
# Firestore cache path unchanged. Uses Node built-ins; no extra package is required.
# REDIS_URL=redis://default:password@host:port
# REDIS_STT_CACHE_TTL_SECONDS=604800
# REDIS_TIMEOUT_MS=1500

# Device-level daily AI guard limit + per-IP rate limit for /v1.
BETA_DAILY_AI_LIMIT=50
BETA_OPS_RATE_LIMIT=30

# Feedback → email owner (không cần đọc CLI/Postgres khi scale).
# FEEDBACK_EMAIL_MODE: instant (mỗi feedback 1 mail) | digest (1 mail/tổng hợp — khuyến nghị 50+ user) | off
FEEDBACK_NOTIFY_TO=your-email@gmail.com
FEEDBACK_EMAIL_MODE=digest
FEEDBACK_DIGEST_HOURS=24
# Gmail: bật 2FA → App Password → SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=EnglishMind Beta <your-email@gmail.com>

# B3: block shared_templates when success_score drops below this (default -10).
TEMPLATE_BLOCK_THRESHOLD=-10

# Ralph loop remote control (web-lite /admin/loop + loop-bridge.ps1 on dev machine).
# Generate a long random string; same value in repo root .env as LOOP_BRIDGE_SECRET.
# LOOP_BRIDGE_SECRET=change-me-long-random-bridge-key
