# ─────────────────────────────────────────────────────────────
# EnglishMind backend env. Copy to .env (Railway: set as Variables).
# ─────────────────────────────────────────────────────────────

# Port (Railway injects PORT automatically; default 8080 locally)
PORT=8080
# Railway deploy stability (set as service Variables on Railway, not in .env locally):
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
# RAILWAY_HEALTHCHECK_TIMEOUT_SEC=60
# SHUTDOWN_GRACE_MS=25000

# Gemini API key held ONLY on the server (never ship to client).
GEMINI_API_KEY=your-gemini-api-key
# Default model for the Pro AI proxy.
GEMINI_MODEL=gemini-2.0-flash

# Firebase Admin credentials.
# Option A (recommended on Railway): paste the full service-account JSON
# as a single-line value of FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Option B (local): point GOOGLE_APPLICATION_CREDENTIALS to a key file
# and leave FIREBASE_SERVICE_ACCOUNT empty.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# AI-SAFE plan-based daily quota (source of truth for /api/ai/generate).
FREE_DAILY_AI_UNITS=10
PLUS_DAILY_AI_UNITS=100
PRO_DAILY_AI_UNITS=250
COACH_BETA_DAILY_AI_UNITS=250
# Required when admin custom claim is true; never leave empty in production.
ADMIN_DAILY_AI_UNITS=500
AI_QUOTA_TIMEOUT_MS=1500
# Timezone used to compute the "server day" for quota reset.
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh

# Optional: upstream content server to proxy GET content endpoints to,
# so curricula/lessons/vocabulary/tower keep working without re-hosting data.
# Leave empty to return 501 for those endpoints.
CONTENT_UPSTREAM_URL=https://englishmind-content.up.railway.app

# HMAC secret for signing trial-status responses (must match client check if any).
TRIAL_SIGNING_SECRET=change-me
# Trial length in days for new installs.
TRIAL_DAYS=7

# VOICE-STT-SERVER-1: server-side whisper.cpp STT (Dockerfile — NOT Railpack).
# Bật sau khi deploy Docker xong (build ~10–20 phút lần đầu).
SERVER_STT_ENABLED=true
STT_ENGINE=whisper
WHISPER_BIN=/app/bin/whisper-cli
WHISPER_MODEL=/app/models/ggml-base.bin
STT_TIMEOUT_MS=30000
FFMPEG_BIN=ffmpeg

# VOICE-PACK-1D: OTA voice pack (host zip on this server — no Firebase Storage / Blaze).
# After deploy, set PUBLIC URL to your Railway domain + path below.
VOICE_PACK_ENABLED=true
VOICE_PACK_PUBLIC_URL=https://englishmind-backen-production.up.railway.app/static/voice-packs/voice-pack-v1.zip
VOICE_PACK_SHA256=af2db21eaf031327e3038668ee167c0a28c1bc1f7e0666a70932eb8fe5b4ecb7
VOICE_PACK_SIZE_BYTES=230
VOICE_PACK_VERSION=v1
VOICE_PACK_ENGINE=mock
VOICE_PACK_MIN_APP_VERSION=1.0.2-beta
VOICE_PACK_PRO_ONLY=false
VOICE_PACK_SIGNING_SECRET=change-me-voice-pack-signing-secret

# B1: Beta Ops — auth key for /v1/feedback, /v1/bug-report, /v1/event, /v1/ai/*.
# Must equal the client's BETA_OPS_API_SECRET and be >= 24 chars.
BETA_OPS_KEY=change-me-to-a-long-random-string
# Railway PostgreSQL (beta_feedback, beta_bug_report, ai_usage_daily, beta_event_log).
# Leave empty -> feedback/bug/event return 503, can-use fails open.
DATABASE_URL=
# Set to "require" when DATABASE_URL is Railway's PUBLIC proxy URL (TLS, no CA verify).
# PGSSL=require
# Device-level daily AI guard limit + per-IP rate limit for /v1.
BETA_DAILY_AI_LIMIT=50
BETA_OPS_RATE_LIMIT=30

# Feedback → email owner (không cần đọc CLI/Postgres khi scale).
# FEEDBACK_EMAIL_MODE: instant (mỗi feedback 1 mail) | digest (1 mail/tổng hợp — khuyến nghị 50+ user) | off
FEEDBACK_NOTIFY_TO=your-email@gmail.com
FEEDBACK_EMAIL_MODE=digest
FEEDBACK_DIGEST_HOURS=24
# Gmail: bật 2FA → App Password → SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=EnglishMind Beta <your-email@gmail.com>

# B3: block shared_templates when success_score drops below this (default -10).
TEMPLATE_BLOCK_THRESHOLD=-10
